{
  "info": {
    "name": "4M Change Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Sequelize + RBAC API collection"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "requestId", "value": "1" },
    { "key": "userId", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@example.com\",\n  \"password\": \"Super@123\"\n}"
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/profile"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Quality Manager\",\n  \"email\": \"quality.manager@example.com\",\n  \"password\": \"Manager@123\",\n  \"role\": \"Manager\"\n}"
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/users/{{userId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\",\n  \"role\": \"Admin\"\n}"
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Change Requests",
      "item": [
        {
          "name": "Create Change",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/change",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"Man\",\n  \"title\": \"Operator Skill Matrix Update\",\n  \"description\": \"Introduce revised skill matrix for line operators.\",\n  \"current_state\": \"Skill levels are tracked manually.\",\n  \"proposed_change\": \"Digitize matrix and update competency levels.\",\n  \"reason\": \"Reduce training gaps.\",\n  \"impact_analysis\": \"Expected 15% reduction in onboarding time.\",\n  \"risk_level\": \"Low\",\n  \"department\": \"HR\"\n}"
            }
          }
        },
        {
          "name": "Get Changes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/change?status=Pending&page=1&limit=10&sortBy=created_at&sortOrder=DESC"
          }
        },
        {
          "name": "Get Change By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/change/{{requestId}}"
          }
        },
        {
          "name": "Update Change",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/change/{{requestId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"department\": \"Production\"\n}"
            }
          }
        },
        {
          "name": "Delete Change",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/change/{{requestId}}"
          }
        },
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/change/dashboard/stats"
          }
        }
      ]
    },
    {
      "name": "Approvals",
      "item": [
        {
          "name": "Create Approval",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/approval",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_id\": {{requestId}},\n  \"status\": \"Approved\",\n  \"remarks\": \"Stage approved after controls review\"\n}"
            }
          }
        },
        {
          "name": "Get Approvals By Request",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/approval/{{requestId}}"
          }
        }
      ]
    },
    {
      "name": "Files",
      "item": [
        {
          "name": "Upload Attachment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/files/{{requestId}}/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" }
              ]
            }
          }
        },
        {
          "name": "List Attachments By Request",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/files/request/{{requestId}}"
          }
        },
        {
          "name": "Download Attachment",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/files/<filename>"
          }
        },
        {
          "name": "Delete Attachment",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/files/1"
          }
        }
      ]
    }
  ]
}