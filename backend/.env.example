PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# SuperAdmin bootstrap
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change_this_password

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# Database
DB_HOST=localhost
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=change_management
DB_PORT=3306
SEED_DEMO_DATA=false

# Demo accounts for testing (enabled when SEED_DEMO_DATA=true)
# manager@example.com / Password@123
# admin@example.com / Password@123
# quality.approver@example.com / Password@123
# manager.approver@example.com / Password@123
# man.user@example.com / Password@123
# machine.user@example.com / Password@123
# method.user@example.com / Password@123
# material.user@example.com / Password@123
# general.user@example.com / Password@123

# Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# CORS
# Use comma-separated origins for multi-network frontend access.
# Example:
# CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174,http://192.168.1.33:5174
CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174
